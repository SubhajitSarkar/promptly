{
  "type": "sysinfo",
  "style": "plain",
  "foreground": "#A6E3A1",
  "foreground_templates": [
    "{{ if gt .PhysicalPercentUsed 90.0 }}#F38BA8{{ end }}",
    "{{ if gt .PhysicalPercentUsed 75.0 }}#F9E2AF{{ end }}"
  ],
  "properties": {
    "always_enabled": false
  },
  "template": "##ICON## {{ round .PhysicalPercentUsed 0 }}% "
}

# segment: dotnet
# description: Shows .NET SDK version inside projects with *.csproj or *.sln
# elements: dotnet_version
typeset -g POWERLEVEL9K_DOTNET_VERSION_FOREGROUND=99
typeset -g POWERLEVEL9K_DOTNET_VERSION_PROJECT_ONLY=true
typeset -g POWERLEVEL9K_DOTNET_VERSION_VISUAL_IDENTIFIER_EXPANSION='##ICON##'

# segment: go
# description: Shows Go version inside projects with go.mod
# elements: goenv
typeset -g POWERLEVEL9K_GOENV_FOREGROUND=43
typeset -g POWERLEVEL9K_GOENV_SOURCES=(shell local global)
typeset -g POWERLEVEL9K_GOENV_PROMPT_ALWAYS_SHOW=false
typeset -g POWERLEVEL9K_GOENV_SHOW_SYSTEM=true
typeset -g POWERLEVEL9K_GOENV_VISUAL_IDENTIFIER_EXPANSION='##ICON##'

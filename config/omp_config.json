{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "#ACB0BE",
          "template": "{{ if .WSL }}WSL{{ else }}{{ .Icon }}{{ end }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#89B4FA",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "\uf07b",
            "home_icon": "~"
          },
          "template": "\uf07c <b>{{ .Path }}</b> "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#A6E3A1",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FAB387{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#F38BA8{{ end }}",
            "{{ if gt .Ahead 0 }}#89DCEB{{ end }}",
            "{{ if gt .Behind 0 }}#F9E2AF{{ end }}"
          ],
          "properties": {
            "branch_icon": "\uf126 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{ .BranchStatus }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "#A6E3A1",
          "properties": {
            "fetch_package_manager": true,
            "display_mode": "files",
            "files": ["package.json", ".nvmrc", ".node-version"]
          },
          "template": "\u2b21 {{ .Full }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#89DCEB",
          "properties": {
            "display_mode": "files",
            "fetch_virtual_env": true,
            "files": ["*.py", "requirements.txt", "pyproject.toml", "Pipfile", ".python-version"]
          },
          "template": "\uf81f {{ if .Venv }}\uf10c {{ .Venv }} {{ end }}{{ .Full }} "
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "#89B4FA",
          "properties": {
            "display_mode": "files",
            "files": ["go.mod", "go.sum", "*.go"]
          },
          "template": "\ue626 {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "#FAB387",
          "properties": {
            "display_mode": "files",
            "files": ["Cargo.toml", "Cargo.lock", "*.rs"]
          },
          "template": "\ue7a8 {{ .Full }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#F9E2AF",
          "properties": {
            "threshold": 3000,
            "style": "austin",
            "always_enabled": false
          },
          "template": "\uf252 {{ .FormattedMs }} "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#F38BA8",
          "foreground_templates": ["{{ if eq .Code 0 }}#A6E3A1{{ end }}"],
          "properties": {
            "always_enabled": false
          },
          "template": "{{ if gt .Code 0 }}\u2718 {{ .Code }}{{ end }} "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#6C7086",
          "template": "\uf017 {{ .CurrentDate | date \"03:04 PM\" }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#F38BA8{{ end }}"
          ],
          "foreground": "#A6E3A1",
          "template": "\u276f "
        }
      ]
    }
  ]
}

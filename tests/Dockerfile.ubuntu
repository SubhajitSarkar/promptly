FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/root
ENV TERM=xterm-256color

# Prerequisites: git, curl, zsh, python3 (for JSON assertions), sudo
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      git curl zsh python3 sudo ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Give root passwordless sudo (mirrors a typical dev machine)
RUN echo "root ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

WORKDIR /promptly
COPY . .

RUN chmod +x install.sh uninstall.sh tests/run_tests.sh tests/*.sh

CMD ["bash", "tests/run_tests.sh"]

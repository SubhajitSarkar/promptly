FROM archlinux:latest

ENV HOME=/root
ENV TERM=xterm-256color

RUN pacman -Sy --noconfirm git curl zsh python sudo && \
    pacman -Scc --noconfirm

RUN echo "root ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

WORKDIR /promptly
COPY . .

RUN chmod +x install.sh uninstall.sh tests/run_tests.sh tests/*.sh

CMD ["bash", "tests/run_tests.sh"]
